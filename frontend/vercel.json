{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://concept-check-api.onrender.com/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://concept-check-api.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
