# Backend-only credentials. Never place provider keys in frontend configuration.
OPENAI_API_KEY=
FISH_AUDIO_API_KEY=

# Set a persistent unpredictable signing secret to retain browser ownership on restart.
SECRET_KEY=

# Staff endpoints remain unavailable until a private key is configured.
REVIEWER_API_KEY=

# Optional setting names (omit them to use application defaults):
# DATABASE_URL
# OPENAI_MODEL
# FISH_AUDIO_MODEL
# CORS_ORIGINS
# ENVIRONMENT
